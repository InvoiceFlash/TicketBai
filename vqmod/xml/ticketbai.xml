	<!-- Modulo TicketBai, independiente: solo se ancla al nucleo de InvoiceFlash 0.0.17 o posterior. -->

	<!-- Ventas > TicketBAI + autoinstalacion de la tabla tbai_invoice y de los permisos
	     del grupo 1. -->
	<file name="admin/controller/common/header.php">
		<operation error="skip">
			<search position="before"><![CDATA[if ($sales) {]]></search>
			<add><![CDATA[
			// TicketBAI (modulo TicketBai): autoinstalacion idempotente
			try {
				$this->load->model('ticketbai/ticketbai');
				$this->model_ticketbai_ticketbai->install();

				$ticketbai_group = $this->db->query("SELECT permission FROM `" . DB_PREFIX . "user_group` WHERE user_group_id = 1");

				if ($ticketbai_group->num_rows) {
					$ticketbai_perm = unserialize($ticketbai_group->row['permission']);

					if (is_array($ticketbai_perm) && isset($ticketbai_perm['access']) && isset($ticketbai_perm['modify'])) {
						$ticketbai_perm_changed = false;

						foreach (array('access', 'modify') as $ticketbai_type) {
							if (!in_array('ticketbai/ticketbai', $ticketbai_perm[$ticketbai_type])) {
								$ticketbai_perm[$ticketbai_type][] = 'ticketbai/ticketbai';
								$ticketbai_perm_changed = true;
							}
						}

						if ($ticketbai_perm_changed) {
							$this->db->query("UPDATE `" . DB_PREFIX . "user_group` SET permission = '" . $this->db->escape(serialize($ticketbai_perm)) . "' WHERE user_group_id = 1");
						}
					}
				}
			} catch (Exception $ticketbai_install_exception) {
				// No interrumpir la carga del admin; se reintenta en la siguiente carga.
			}

			if ($this->user->hasPermission('access', 'ticketbai/ticketbai')) {
				$sales[] = array(
					'name' => $this->language->get('text_ticketbai'),
					'href' => $this->url->link('ticketbai/ticketbai', 'token=' . $this->session->data['token'], 'SSL'),
					'children' => array()
				);
			}

			]]></add>
		</operation>
	</file>

