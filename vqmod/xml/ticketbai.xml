				$this->data['text_info_status'] = $this->model_ticketbai_ticketbai->label('text_info_status');
				$this->data['text_info_notice'] = $this->model_ticketbai_ticketbai->label('text_info_notice');
				$this->data['text_info_identifier'] = $this->model_ticketbai_ticketbai->label('text_info_identifier');
				$this->data['button_resend_invoice'] = $this->model_ticketbai_ticketbai->label('button_resend_invoice');

				$tbai_info = $this->model_ticketbai_ticketbai->getInfo($invoice_id);

				$this->data['tbai_sent_date'] = $tbai_info['sent_date'];
				$this->data['tbai_status'] = $tbai_info['status'];
				$this->data['tbai_notice'] = $tbai_info['notice'];
				$this->data['tbai_identifier'] = $tbai_info['identifier'];
]]></add>
		</operation>

		<!-- Factura impresa: QR TBAI (se calcula antes de montar el array de la factura) -->
